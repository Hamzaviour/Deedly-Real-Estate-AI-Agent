# Copy to .env and fill in ONE of the keys below. Never commit .env.

# Option 1: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional. Unset, the best available model is picked automatically.
# GROQ_MODEL=openai/gpt-oss-120b

# Option 2: Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional override. Default: claude-opus-5-5
# RE_AGENT_MODEL=claude-opus-5-5

# Optional. Force a provider when both keys are set: groq or anthropic.
# RE_AGENT_PROVIDER=groq
